# ==============================
# IntelliJ IDEA
# ==============================

# IntelliJ 프로젝트 설정
.idea/

# IntelliJ 모듈 파일
*.iml


# ==============================
# Java / Build
# ==============================

# 컴파일된 Java 클래스 파일
*.class

# IntelliJ 빌드 결과
out/

# 일반적인 빌드 결과
build/

# Maven 빌드 결과
target/

# Gradle 캐시 및 빌드 파일
.gradle/


# ==============================
# Libraries
# ==============================

# 직접 받은 Lombok 라이브러리
lib/lombok.jar


# ==============================
# Logs / Temporary files
# ==============================

# 로그 파일
*.log

# 임시 파일
*.tmp
*.temp

# 백업 파일
*.bak

# Vim / 기타 편집기 임시 파일
*.swp


# ==============================
# OS generated files
# ==============================

# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store


# ==============================
# Local / Secret files
# ==============================

# 환경 변수 및 로컬 설정
.env
.env.local

# 로컬 설정 파일
local.properties

# 개인용 설정 / 인증 정보
*.secret